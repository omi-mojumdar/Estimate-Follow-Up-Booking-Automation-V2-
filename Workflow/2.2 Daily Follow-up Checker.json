      "name": "Run Every Day at 9 AM"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nfunction getTimezoneByZip(zip) {\n  const zipNum = parseInt(zip);\n  \n  // Eastern Time\n  if ((zipNum >= 10000 && zipNum <= 19999) || // NY, PA\n      (zipNum >= 20000 && zipNum <= 29999) || // DC, VA, NC, SC\n      (zipNum >= 30000 && zipNum <= 34999) || // GA, FL\n      (zipNum >= 38600 && zipNum <= 39999) || // MS, TN parts\n      (zipNum >= 40000 && zipNum <= 42999) || // KY\n      (zipNum >= 43000 && zipNum <= 45999) || // OH\n      (zipNum >= 48000 && zipNum <= 49999))   // MI\n    return 'America/New_York';\n  \n  // Central Time\n  if ((zipNum >= 35000 && zipNum <= 36999) || // AL\n      (zipNum >= 37000 && zipNum <= 38599) || // TN\n      (zipNum >= 46000 && zipNum <= 47999) || // IN parts\n      (zipNum >= 50000 && zipNum <= 52999) || // IA\n      (zipNum >= 53000 && zipNum <= 54999) || // WI\n      (zipNum >= 55000 && zipNum <= 56999) || // MN\n      (zipNum >= 57000 && zipNum <= 57999) || // SD\n      (zipNum >= 58000 && zipNum <= 58999) || // ND\n      (zipNum >= 60000 && zipNum <= 62999) || // IL\n      (zipNum >= 63000 && zipNum <= 65999) || // MO\n      (zipNum >= 66000 && zipNum <= 67999) || // KS\n      (zipNum >= 68000 && zipNum <= 69999) || // NE\n      (zipNum >= 70000 && zipNum <= 71999) || // LA\n      (zipNum >= 72000 && zipNum <= 72999) || // AR\n      (zipNum >= 73000 && zipNum <= 74999) || // OK\n      (zipNum >= 75000 && zipNum <= 79999))   // TX\n    return 'America/Chicago';\n  \n  // Mountain Time\n  if ((zipNum >= 80000 && zipNum <= 81999) || // CO\n      (zipNum >= 82000 && zipNum <= 83199) || // WY\n      (zipNum >= 83200 && zipNum <= 83999) || // ID parts\n      (zipNum >= 84000 && zipNum <= 84999) || // UT\n      (zipNum >= 85000 && zipNum <= 86999) || // AZ\n      (zipNum >= 87000 && zipNum <= 88499) || // NM\n      (zipNum >= 59000 && zipNum <= 59999))   // MT\n    return 'America/Denver';\n  \n  // Pacific Time\n  if ((zipNum >= 89000 && zipNum <= 89999) || // NV\n      (zipNum >= 90000 && zipNum <= 96199) || // CA\n      (zipNum >= 97000 && zipNum <= 97999) || // OR\n      (zipNum >= 98000 && zipNum <= 99499))   // WA\n    return 'America/Los_Angeles';\n\n  // Alaska\n  if (zipNum >= 99500 && zipNum <= 99999)\n    return 'America/Anchorage';\n\n  // Hawaii\n  if (zipNum >= 96700 && zipNum <= 96899)\n    return 'America/Honolulu';\n\n  // Default to Eastern if unknown\n  return 'America/New_York';\n}\n\nconst rows = $input.all();\n\nconst toProcess = rows.filter(row => {\n  const status = row.json['Status'];\n  const optOut = row.json['Opt-Out'];\n  const nextFollowUp = new Date(row.json['Next Follow-up Date']);\n  nextFollowUp.setHours(0, 0, 0, 0);\n  const lastSent = row.json['Last Follow-up Date'];\n  const zip = row.json['ZIP Code']?.toString().trim();\n\n  const timezone = getTimezoneByZip(zip);\n\n  const localHour = parseInt(new Intl.DateTimeFormat('en-US', {\n    timeZone: timezone,\n    hour: 'numeric',\n    hour12: false\n  }).format(now));\n\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n  const todayStr = today.toISOString().split('T')[0];\n\n  return (\n    status === 'Pending' &&\n    optOut === 'No' &&\n    nextFollowUp <= today &&\n    lastSent !== todayStr &&\n    localHour >= 9 &&\n    localHour < 11\n  );\n});\n\nreturn toProcess;"
      },
