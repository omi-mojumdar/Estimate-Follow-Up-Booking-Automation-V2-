        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Booking Confirmed!</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      font-family: Arial, sans-serif;\n      background-color: #f0faf8;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n    }\n    .card {\n      background: white;\n      border-radius: 12px;\n      padding: 50px 40px;\n      text-align: center;\n      max-width: 480px;\n      width: 90%;\n      box-shadow: 0 4px 20px rgba(0,0,0,0.1);\n    }\n    .checkmark {\n      font-size: 64px;\n      margin-bottom: 20px;\n    }\n    h1 {\n      color: #00897B;\n      font-size: 28px;\n      margin-bottom: 12px;\n    }\n    p {\n      color: #555;\n      font-size: 16px;\n      line-height: 1.6;\n      margin-bottom: 10px;\n    }\n    .footer {\n      margin-top: 30px;\n      color: #999;\n      font-size: 13px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"checkmark\">✅</div>\n    <h1>Booking Confirmed!</h1>\n    <p>Thank you! Your cleaning appointment has been successfully confirmed.</p>\n    <p>Our team will reach out shortly with your appointment details.</p>\n    <div class=\"footer\">— CleanFlow Team</div>\n  </div>\n</body>\n</html>",
