      "parameters": {
        "sendTo": "tirthomoj@gmail.com",
        "subject": "📩 Customer Replied — Action Needed",
        "message": "=<p>Hi,</p>\n\n<p>A customer has replied to their follow-up email. Here are the details:</p>\n\n<table style=\"border-collapse:collapse; width:100%;\">\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Customer Name</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('Is Reply From Known Customer?').item.json.customerName }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Email</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('Is Reply From Known Customer?').item.json.email }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px; border:1px solid #ddd;\"><strong>Estimate ID</strong></td>\n    <td style=\"padding:8px; border:1px solid #ddd;\">{{ $('Is Reply From Known Customer?').item.json.estimateId }}</td>\n  </tr>\n</table>\n\n<br>\n<p><strong>💬 Customer Message:</strong></p>\n<div style=\"background:#f5f5f5; padding:15px; border-left:4px solid #00897B; border-radius:4px;\">\n {{ $('Match Reply to Estimate').item.json.customerMessage }}\n</div>\n\n<br>\n<p><strong>Choose an action:</strong></p>\n\n<table>\n  <tr>\n    <td style=\"padding:5px;\">\n      <a href=\"https://cebin99345.app.n8n.cloud/webhook/booking-update?estimateId={{ $('Is Reply From Known Customer?').item.json.estimateId }}&status=Booked\"\n         style=\"background-color:#00897B; color:white; padding:12px 24px;\n         text-decoration:none; border-radius:6px; font-weight:bold;\n         font-size:15px; display:inline-block;\">\n        ✅ Mark as Booked\n      </a>\n    </td>\n    <td style=\"padding:5px;\">\n      <a href=\"mailto:{{ $json.email }}?subject=Re: Your Cleaning Estimate&body=Hi {{ $json.customerName }},%0A%0AThank you for getting back to us!%0A%0A\"\n         style=\"background-color:#1565C0; color:white; padding:12px 24px;\n         text-decoration:none; border-radius:6px; font-weight:bold;\n         font-size:15px; display:inline-block;\">\n        📧 Reply to Customer\n      </a>\n    </td>\n    <td style=\"padding:5px;\">\n      <a href=\"https://cebin99345.app.n8n.cloud/webhook/booking-update?estimateId={{ $('Is Reply From Known Customer?').item.json.estimateId }}&status=Opted Out\"\n         style=\"background-color:#e53935; color:white; padding:12px 24px;\n         text-decoration:none; border-radius:6px; font-weight:bold;\n         font-size:15px; display:inline-block;\">\n        ❌ Mark as Opted Out\n      </a>\n    </td>\n  </tr>\n</table>\n\n<br>\n<p style=\"color:#999; font-size:13px;\">— CleanFlow Automation</p>",
