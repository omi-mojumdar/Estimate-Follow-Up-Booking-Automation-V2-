      "parameters": {
        "jsCode": "const gmailData = $('Watch for Customer Replies').first().json;\n\nlet incomingEmail = '';\nconst rawFrom = gmailData.From || gmailData.from || '';\n\nif (typeof rawFrom === 'string') {\n  const match = rawFrom.match(/<(.+?)>/) || rawFrom.match(/([^\\s]+@[^\\s]+)/);\n  incomingEmail = match ? match[1].toLowerCase() : rawFrom.toLowerCase();\n}\n\n// ✅ Capture the customer message\nconst customerMessage = gmailData.text || gmailData.snippet || 'No message content found';\n\nconst allRows = $input.all();\nconst matchedRow = allRows.find(row => {\n  return (row.json['Email'] || '').toLowerCase().trim() === incomingEmail.trim();\n});\n\nif (!matchedRow) {\n  return [{ json: { matched: false, incomingEmail: incomingEmail }}];\n}\n\nreturn [{ json: {\n  matched: true,\n  estimateId: matchedRow.json['Estimate ID'],\n  customerName: matchedRow.json['Customer Name'],\n  email: matchedRow.json['Email'],\n  rowNumber: matchedRow.json['row_number'],\n  customerMessage: customerMessage  // ✅ Now included!\n}}];"
      },
