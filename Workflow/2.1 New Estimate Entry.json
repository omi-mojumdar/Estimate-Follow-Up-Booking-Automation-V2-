      "parameters": {
        "jsCode": "const today = new Date();\nconst followUpDate = new Date(today);\nfollowUpDate.setDate(today.getDate() + 2);\n\nconst estimateId = 'EST-' + Date.now();\n\n// Get form data\nconst customerName = $input.item.json.body.customerName;\nconst email = $input.item.json.body.email;\nconst serviceType = $input.item.json.body.serviceType;\nconst bedrooms = parseInt($input.item.json.body.bedrooms) || 0;\nconst bathrooms = parseInt($input.item.json.body.bathrooms) || 0;\nconst zipCode = $input.item.json.body.zipCode;\n\n// Auto-calculate price based on any bed/bath combination\nlet price = 100;\nprice += bedrooms * 25;\nprice += bathrooms * 20;\n\nif (serviceType === 'Move In / Move Out') price += 50;\nif (serviceType === 'Deep Clean') price += 75;\nif (serviceType === 'Post Construction') price += 100;\n\nreturn [{\n  json: {\n    estimateId: estimateId,\n    customerName: customerName,\n    email: email,\n    serviceType: serviceType,\n    bedrooms: bedrooms,\n    bathrooms: bathrooms,\n    zipCode: zipCode,\n    estimateAmount: price,\n    estimateDate: today.toISOString().split('T')[0],\n    status: 'Pending',\n    followUpCount: 0,\n    lastFollowUpDate: '',\n    nextFollowUpDate: followUpDate.toISOString().split('T')[0],\n    optOut: 'No',\n    notes: '',\n    replyReceived: 'No'\n  }\n}];"
      },
